PORT=5000
CLIENT_URL=http://localhost:3000
# Enter your MongoDB Atlas URI here. Leave blank if running in standalone/offline mode:
MONGODB_URI=
# AI Provider configuration: 'heuristic' (zero-config, offline), 'ibm_bob', 'openai_compatible', 'gemini'
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=ibm-bob-appsec
